        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and IndividualESP[p.UserId] then
            local hum = char.Humanoid; local hrp = char.HumanoidRootPart;
            local isAlly = (AllyAllActive and Allies[p.UserId] ~= false) or Allies[p.UserId] == true
            local hl = char:FindFirstChild("ArthurHL") or Instance.new("Highlight", char); hl.Name = "ArthurHL"; hl.FillTransparency = 1
