-- [[ AIM ENGINE ]]
RunService.RenderStepped:Connect(function()
    if not ScriptRunning or not IsUnlocked then return end
    local isPressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if not isPressed then LockedTarget = nil end
    if AimEnabled and isPressed then
        if not LockedTarget then
            local t, d = nil, AimFOV
            for _, v in pairs(Players:GetPlayers()) do
                local isAlly = (AllyAllActive and Allies[v.UserId] ~= false) or Allies[v.UserId] == true
                if v ~= LocalPlayer and not isAlly and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
                    local head = v.Character.Head; local pos, vis = Camera:WorldToViewportPoint(head.Position)
                    if vis then
                        local canSee = true
                        if WallCheckEnabled then local pts = Camera:GetPartsObscuringTarget({Camera.CFrame.Position, head.Position}, {LocalPlayer.Character, v.Character}); if #pts > 0 then canSee = false end end
                        local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                        if canSee and dist < d then d = dist; t = v end
                    end
                end
            end
            LockedTarget = t
        end
        if LockedTarget and LockedTarget.Character and LockedTarget.Character:FindFirstChild("Head") then
            local TargetHead = LockedTarget.Character.Head
            local FinalVector = AimOffset 
            if AutoDistanceAdj and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (LocalPlayer.Character.HumanoidRootPart.Position - TargetHead.Position).Magnitude
                if dist > 25 then FinalVector = AimOffset + ((dist - 25) * 0.048) end
            end
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, TargetHead.Position + Vector3.new(0, FinalVector, 0)), AimSmoothness)
        end
    end
end)

