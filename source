local function HandleESP(p)
    RunService.RenderStepped:Connect(function()
        if not ScriptRunning or p == LocalPlayer then return end
        local char = p.Character
        if char and char:FindFirstChild("HumanoidRootPart") and (VisualsEnabled or IndividualESP[p.UserId]) then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local isAlly = Allies[p.UserId] == true
            local hl = char:FindFirstChild("ArthurHL") or Instance.new("Highlight", char); hl.Name = "ArthurHL"; hl.FillTransparency = 1
            hl.OutlineColor = isAlly and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
            local bbu = char:FindFirstChild("ArthurESP") or Instance.new("BillboardGui", char); bbu.Name = "ArthurESP"; bbu.AlwaysOnTop = true; bbu.Size = UDim2.new(0, 200, 0, 50); bbu.Adornee = char.HumanoidRootPart; bbu.ExtentsOffset = Vector3.new(0, -3.8, 0)
            local txt = bbu:FindFirstChild("Info") or Instance.new("TextLabel", bbu); txt.Name = "Info"; txt.BackgroundTransparency = 1; txt.Size = UDim2.new(1,0,1,0); txt.Font = "GothamBold"; txt.TextSize = 10; txt.TextColor3 = isAlly and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 255, 255)
            txt.Text = string.upper(p.Name) .. " | " .. (hum and math.floor(hum.Health) or "0") .. " HP"
        else
            if char and char:FindFirstChild("ArthurHL") then char.ArthurHL:Destroy() end
            if char and char:FindFirstChild("ArthurESP") then char.ArthurESP:Destroy() end
        end
    end)
end

