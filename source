-- AIMBOT LOOP (Rendering)
RunService.RenderStepped:Connect(function()
    if IsUnlocked and AimEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        if not CurrentTarget then CurrentTarget = GetClosestToMouse() end
        if CurrentTarget and CurrentTarget.Character and CurrentTarget.Character:FindFirstChild("Head") then
            local lockedHead = CurrentTarget.Character.Head
            local _, onScreen = Camera:WorldToViewportPoint(lockedHead.Position)
            if onScreen and CurrentTarget.Character.Humanoid.Health > 0 then
                local targetCFrame = CFrame.new(Camera.CFrame.p, lockedHead.Position + Vector3.new(0, AimOffset, 0))
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, AimSmoothness) 
            else CurrentTarget = nil end
        end
    else CurrentTarget = nil end
end)

