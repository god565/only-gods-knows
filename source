-- [[ IMPROVED SILENT AIM LOGIC ]]
local function GetClosestToMouse()
    local target = nil
    local dist = AimFOV
    local mPos = UserInputService:GetMouseLocation()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Head") and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local head = v.Character.Head
            local screenPos, vis = Camera:WorldToViewportPoint(head.Position)
            
            if vis then
                local magnitude = (Vector2.new(screenPos.X, screenPos.Y) - mPos).Magnitude
                if magnitude < dist then
                    -- Wall Check Logic
                    if WallCheckEnabled then
                        local parts = Camera:GetPartsObscuringTarget({head.Position}, {LocalPlayer.Character, v.Character})
                        if #parts == 0 then
                            dist = magnitude
                            target = v
                        end
                    else
                        dist = magnitude
                        target = v
                    end
                end
            end
        end
    end
    return target
end

