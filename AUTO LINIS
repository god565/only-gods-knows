-- LEGIT HOLD LOGIC
local function safeHold(prompt)
    if _G.AutoLinis then
        task.wait(0.2)
        if player:DistanceFromCharacter(prompt.Parent.Position) < 7 then
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + math.random(1, 5)/10) -- Random konti ang delay ng bitaw
            prompt:InputHoldEnd()
        end
    end
end

-- SMART AVOIDANCE (AUTO DIRECTION CHANGE)
local function getSafePoint(targetPos)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return targetPos end
    
    local root = char.HumanoidRootPart
    local lookVector = (targetPos - root.Position).Unit
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

    local ray = workspace:Raycast(root.Position, lookVector * 6, raycastParams)

    if ray then
        local leftVector = CFrame.Angles(0, math.rad(45), 0) * lookVector
        local rightVector = CFrame.Angles(0, math.rad(-45), 0) * lookVector
        
        local rayLeft = workspace:Raycast(root.Position, leftVector * 7, raycastParams)
        local rayRight = workspace:Raycast(root.Position, rightVector * 7, raycastParams)

        if not rayLeft then
            return root.Position + (leftVector * 5)
        elseif not rayRight then
            return root.Position + (rightVector * 5)
        else
            return root.Position - (lookVector * 4)
        end
    end
    return targetPos
end

-- HUMANIZED MOVEMENT LOGIC
local lastRandomOffset = Vector3.new(0,0,0)
local nextOffsetTime = 0

local function getHumanizedPoint(targetPos)
    local root = player.Character.HumanoidRootPart
    local distToTarget = (targetPos - root.Position).Magnitude
    
    if tick() > nextOffsetTime then
        if distToTarget > 12 then
            -- "Lilihis" ng konti para hindi diretso ang lakad (zig-zag)
            lastRandomOffset = Vector3.new(math.random(-4, 4), 0, math.random(-4, 4))
        else
            -- Kapag malapit na, dahan-dahang ituwid ang lakad
            lastRandomOffset = lastRandomOffset * 0.3
        end
        nextOffsetTime = tick() + math.random(7, 12)/10 -- Random timing ng pag-offset
    end
    
    local safePoint = getSafePoint(targetPos)
    return safePoint + lastRandomOffset
end

-- MOVEMENT LOOP
task.spawn(function()
    while task.wait(0.1) do
        if _G.AutoLinis then
            pcall(function()
                local char = player.Character
                local hum = char:FindFirstChild("Humanoid")
                local root = char:FindFirstChild("HumanoidRootPart")

                if hum and root then
                    hum.WalkSpeed = _G.WalkSpeedValue

                    local target = nil
                    local targetPrompt = nil
                    local dist = 300

                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and (v.ObjectText:find("Clean") or v.ActionText:find("Clean")) then
                            local part = v.Parent
                            if part and part:IsA("BasePart") then
                                local mag = (root.Position - part.Position).Magnitude
                                if mag < dist then
                                    dist = mag
                                    target = part
                                    targetPrompt = v
                                end
                            end
                        end
                    end

                    if target and targetPrompt then
                        local humanPoint = getHumanizedPoint(target.Position)
                        
                        if dist > 6 then
                            hum:MoveTo(humanPoint)
                        else
                            -- Kapag malapit na talaga, ituwid na para hindi lumampas
                            hum:MoveTo(target.Position)
                            if dist < 4.5 then
                                hum:MoveTo(root.Position) -- Stop
                                safeHold(targetPrompt)
                                task.wait(0.5) -- Konting pahinga bago lumipat sa susunod
                            end
                        end
                    end
                end
            end)
        end
    end
end)
